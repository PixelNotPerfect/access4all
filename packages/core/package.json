{
  "name": "@access4all/core",
  "version": "0.1.0",
  "description": "Référentiel RGAA 4.1.2 + WCAG 2.2, conseils par métier, correspondance axe-core, calcul de conformité et calendrier d'actions.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "^4.10.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
